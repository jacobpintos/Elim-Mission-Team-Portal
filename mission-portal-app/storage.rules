rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Users can read and write their own avatar
    match /avatars/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // App logo — public read so the login screen loads without auth;
    // only admins may write.
    match /logos/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Chat image attachments, written by messages/[threadId].tsx. Without this
    // rule Storage denied every upload by default, so image attachments never
    // worked at all.
    //
    // Storage rules cannot read Firestore, so room membership cannot be checked
    // here; any signed-in user can read, matching how avatars already work.
    // Delete is allowed so an admin can purge a reported image from the
    // moderation queue — the Firestore rules are what gate who sees a room.
    match /rooms/{roomId}/attachments/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Photos attached to security incident reports, written by
    // securityStore.createReport(). Same problem as above — previously denied.
    // dailyCleanup removes these with the Admin SDK when a report's retention
    // expires, which bypasses these rules.
    match /securityReports/{reportId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
  }
}
