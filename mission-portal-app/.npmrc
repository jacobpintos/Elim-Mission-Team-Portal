# This project's dependency tree only resolves with legacy peer handling, which
# CI already passes explicitly on `npm ci --legacy-peer-deps`. EAS Build runs a
# plain `npm ci --include=dev` and had no way to know that, so a lock file
# generated with the flag was missing the peer-pulled packages a strict install
# then demanded, and the build died in Install dependencies. Setting it here
# makes every install site — local, CI and EAS — resolve the same way.
legacy-peer-deps=true
