rules_version = '2';
// Last updated: 2026-10-14 — added reimbursements
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']);
    }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }

    // The one account that sits above admin.
    //
    // A literal uid rather than a role: roles live in this very collection and
    // admins may write it, so an 'owner' role would be a lock whose key is on
    // the same ring. Must match OWNER_UID in functions/src/owner.ts and
    // src/lib/owner.ts.
    function ownerUid() { return '0RUxDLC8QGQ6qBTLgBkoMSgYibJ2'; }
    function isOwnerUid(uid) { return ownerUid() != '' && uid == ownerUid(); }

    // Whether people may make their own account. Off: accounts are made by
    // admins, and a login made some other way — with the app's public key,
    // say — can't give itself a user record, let alone a role. Must match
    // SIGN_UP_ENABLED in src/lib/featureFlags.ts, which says what else goes
    // with turning it on.
    function signUpOpen() { return false; }
    function isOwner() { return isSignedIn() && isOwnerUid(request.auth.uid); }
    // A guest is along for one trip: they may read the worship material they
    // have been added to, and change nothing.
    function isGuest() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles
          .hasAny(['guest']);
    }
    // Any account but a public one: what may keep notes on its own calendar.
    function keepsNotes() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles
          .hasAny(['admin', 'security', 'regular', 'intern', 'worship', 'guest']);
    }
    function isWorshipOrAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles
          .hasAny(['admin', 'worship']);
    }

    match /appSettings/theme {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      // Admins make accounts: createPortalUser writes with the Admin SDK, which
      // these rules don't apply to, and Auth Audit gives a login with no
      // record one here. This used to let anyone signed in write their own
      // record, roles and all — so a login made with the app's public key
      // could make itself an admin. With sign-up open, a new login may write
      // its own record only as public, without what admins set.
      allow create: if isAdmin()
        || (signUpOpen() && isSelf(uid)
            && request.resource.data.roles == ['public']
            && !request.resource.data.keys().hasAny(['sex', 'title']));
      // An admin may act on anyone but the owner. Without this the owner-only
      // callables are decoration: an admin edits the owner's roles down to
      // nothing, or deletes the account outright, from the client.
      //
      // The owner still edits their own record — they hold admin too, so the
      // first clause has to let them through for themselves.
      //
      // `sex` is set by admins in user management, for one thing: the colour of
      // a person's card when a carpool is arranged. Not theirs to change.
      allow update: if (isAdmin() && (!isOwnerUid(uid) || isSelf(uid)))
        || (isSelf(uid) &&
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['roles', 'createdAt', 'sex']))
        || (isSelf(uid) &&
            resource.data.roles.hasOnly(['unverified']) &&
            request.resource.data.roles.hasOnly(['public']) &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt', 'sex']));
      allow delete: if isAdmin() && !isOwnerUid(uid);
    }

    // The name behind a uid, for everyone signed in.
    //
    // `users` above is readable only by its owner and by admins, because it
    // holds push tokens, emails, locations, block lists and report history.
    // That is right for those fields and wrong as an answer to "who is this
    // uid?" — which every member's app asks constantly, for team rosters,
    // message authors and assignment lists. Denied, they rendered raw uids.
    //
    // Mirrored from users/{uid} by mirrorPublicProfile, which runs with Admin
    // SDK privileges and so is unaffected by the closed write rule here. No
    // client may write it: a member editing this collection directly could
    // rename anyone in everyone else's copy of the directory.
    match /publicProfiles/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // A request to be added to the event and meeting texting list.
    //
    // One document per person, keyed by their uid, holding a phone number they
    // typed during sign-up. It is read by textingListDigest through the Admin
    // SDK, which these rules do not apply to, and by admins for support — so
    // no client read is granted to the person who wrote it either. A phone
    // number is worth less exposure than an email address, not more.
    //
    // Writable only by its subject and only as a pending request: `status` is
    // what the digest clears once the Connections Coordinator has it, and a
    // client that could set it would silently drop itself from the list.
    match /textingListSignups/{uid} {
      allow read: if isAdmin();
      allow create: if isSelf(uid) && request.resource.data.status == 'pending';
      allow update: if isSelf(uid)
        && request.resource.data.status == 'pending'
        && request.resource.data.uid == uid;
      allow delete: if isAdmin();
    }

    match /auditLog/{doc} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Phase 2 additions

    match /events/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /avail/{key} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /tasks/{id} {
      allow read: if isSignedIn();
      // Admins make, change and remove tasks.
      allow create, delete: if isAdmin();
      // Someone a task is assigned to may move its status — with when it was
      // done, which the app writes alongside 'done' (tasksStore.setStatus) and
      // cleanup reads, and the projected date it writes alongside 'behind'.
      // Only their own: this used to let any member move anyone's task. A
      // guest may not, being read-only.
      //
      // A reimbursement's task is moved by its callables alone, which change
      // the request with it and tell the person who asked. Marked done here,
      // it would close with the request still open and nobody told.
      allow update: if isAdmin() ||
        (isSignedIn() && !isGuest() &&
         resource.data.get('taskType', '') != 'reimbursement' &&
         resource.data.get('assignees', []).hasAny([request.auth.uid]) &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'doneAt', 'projectedDate', 'overdueNotified', '_updatedAt']));
    }

    match /rooms/{id} {
      allow read: if isSignedIn() && (isAdmin() ||
        resource.data.members.hasAny([request.auth.uid]));
      allow write: if isAdmin();
      allow update: if isSignedIn() &&
        resource.data.members.hasAny([request.auth.uid]) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['reviewers', 'updatedAt']);

      match /messages/{msgId} {
        allow read: if isSignedIn() && (isAdmin() ||
          get(/databases/$(database)/documents/rooms/$(id)).data.members
            .hasAny([request.auth.uid]));
        allow create: if isSignedIn() && (isAdmin() ||
          get(/databases/$(database)/documents/rooms/$(id)).data.members
            .hasAny([request.auth.uid]));
        allow update: if isSignedIn() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['readBy']);
        allow delete: if isAdmin();
      }
    }

    match /announcements/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /notifs/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if isSelf(uid) || isAdmin();
    }

    match /config/main {
      allow read: if isSignedIn();
      allow write: if isAdmin() ||
        (isSignedIn() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['lastSeenPosts'])) ||
        (isSignedIn() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['nReport'])) ||
        (isSignedIn() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['nKaizen'])) ||
        (isWorshipOrAdmin() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['nChordSheet']));
    }

    match /digestStats/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /groups/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /taskTemplates/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Somebody asking to meet one of the leadership team.
    //
    // Read by an admin, and by the people it was actually addressed to. Admin
    // alone was too narrow the moment titles went on: a Worship Leader or a
    // Childcare lead holds no admin role, so they were being notified about a
    // request and then refused the document that described it.
    //
    // Nothing is created from a client. sendMeetingRequest checks the daily
    // limit, takes the sender's name and address from their account rather
    // than the form, and creates the task that goes with it — none of which a
    // direct write would do.
    match /meetingRequests/{id} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.leaders);
      allow create: if false;
      // The people it was sent to may close it off; only an admin may remove it.
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.leaders);
      allow delete: if isAdmin();
    }

    // A request to be paid back for something bought for an event.
    //
    // Read by the person who asked, the Accountant it was sent to, and admins.
    // Kept out of `tasks`, which every member can read, because what someone
    // spent and their receipts are not everyone's business.
    //
    // Nothing is written from a client but one thing: every step — asking,
    // deciding, moving the pay date, paying — goes through a callable in
    // functions/src/reimbursements, which also moves the task and tells the
    // other person. The exception is an admin handing open requests to a new
    // Accountant from Admin → Leadership, which changes who it is sent to and
    // nothing else.
    match /reimbursements/{id} {
      allow read: if isAdmin() || (isSignedIn() &&
        (resource.data.submitterUid == request.auth.uid ||
         resource.data.accountantUid == request.auth.uid));
      allow create, delete: if false;
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['accountantUid', 'accountantName']);
    }

    // How last night's backup went, written by nightlyBackup and shown on
    // Admin → Data. Nothing in it is for anyone but admins.
    match /backupStatus/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /issues/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /kaizen/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin() ||
        (isSignedIn() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['upvotes', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /planningBoards/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /music/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // The service streaming right now.
    //
    // Read is not narrowed by the card's expiry, deliberately. Rules are not
    // filters: a rule reading resource.data is evaluated against every document
    // a query could return, so the moment one expired card existed, the app's
    // listener on this collection would be refused outright rather than
    // returning the live one. Constraining the query to match would then tie
    // every caller to a where() clause that has to agree with this line
    // exactly.
    //
    // Nothing is lost by leaving it out. What is posted here is material the
    // church is publishing openly — anything not meant for a general audience
    // is not posted at all — so an expired card is stale, not sensitive. The
    // window is honoured in the app, and expired documents are deleted outright
    // by the sweepExpiredStreams schedule.
    //
    // If a stream ever does need an audience narrower than "everyone", the test
    // belongs here, and the client query has to be constrained to match it.
    match /livestreams/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Food sign-ups. There was no rule here at all, so every write was
    // default-denied and signing up for a dish silently did nothing.
    // Guests are along for the trip and are not asked to bring food.
    //
    // Admins assign anyone, any way (the event form). Anyone else takes one
    // open item or gives one up per write — never changing a sign-up that is
    // there. The app writes one item at a time (lib/foodSignups); this holds
    // any copy of it to the same, so a screen writing back an old copy of the
    // sheet can't erase what was signed up since. A single sign-up or removal
    // written the old way is still let through, for apps not yet updated.
    match /foodSignups/{key} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !isGuest()
        && (isAdmin() || request.resource.data.get('signups', {}).size() <= 1);
      allow update: if isSignedIn() && !isGuest() && (isAdmin() || oneFoodChange());
      allow delete: if isAdmin();
    }

    // One item taken or given up, and nothing else on the sheet touched.
    function oneFoodChange() {
      let change = request.resource.data.get('signups', {})
        .diff(resource.data.get('signups', {}));
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signups'])
        && change.affectedKeys().size() <= 1
        && change.changedKeys().size() == 0;
    }

    // A date's cars, for an event whose cars aren't set in its form. Arranged
    // by admins — on the event's page, or through Miriam — and only read by
    // anyone else, who is shown the car they are in. Was writable by anyone
    // signed in, though nothing in the app let them.
    match /carpool/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Guests read set lists and chord sheets but never write them. Without the
    // read they would have been given a worship tab that renders nothing.
    // Reminders people set for themselves (Miriam): theirs alone to read and
    // change. Sent by sendDueReminders (functions, as admin).
    match /reminders/{id} {
      allow read, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 300
        && request.resource.data.remindAt is number;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }

    match /setLists/{id} {
      allow read: if isWorshipOrAdmin() || isGuest();
      allow write: if isWorshipOrAdmin();
    }

    // Each person's own notes on chord sheets — song and section notes, keyed
    // by sheet. Private: only the person who wrote them reads them; nobody
    // else, admins included, has any business in them. Deleted with the
    // account (deleteOwnAccount).
    match /sheetNotes/{uid} {
      allow read, write: if isSelf(uid);
    }

    // What people ask Miriam (src/lib/miriamAsked): written by the app as
    // they ask — the words and what kind of account, never who — and read
    // only by the server, for Admin → Analytics (functions: miriamOwnAdmin).
    match /miriamAsked/{id} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['text', 'audience', 'at'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 200
        && request.resource.data.audience in ['public', 'member', 'guest']
        && request.resource.data.at == request.time;
      allow read, update, delete: if false;
    }

    // How Miriam is doing (functions/src/miriam/stats): the app writes only
    // that it handled a request itself, or that a change she showed was
    // confirmed or cancelled — never the words, never who. The server writes
    // the rest, and reads them only for Admin → Miriam (functions: miriamOwnAdmin).
    match /miriamEvents/{id} {
      allow create: if isSignedIn()
        && request.resource.data.at == request.time
        && (
          (request.resource.data.keys().hasOnly(['kind', 'tier', 'outcome', 'at'])
            && request.resource.data.kind == 'turn'
            && request.resource.data.tier == 'phone'
            && request.resource.data.outcome == 'handled')
          || (request.resource.data.keys().hasOnly(['kind', 'outcome', 'at'])
            && request.resource.data.kind == 'card'
            && request.resource.data.outcome in ['confirmed', 'cancelled'])
        );
      allow read, update, delete: if false;
    }

    // Each person's notes on days of their own calendar (src/stores/
    // dateNotesStore): theirs alone — nobody else reads them, an admin
    // included. Kept by anyone with more than a public account, at most a
    // thousand; read and cleared by their owner whatever their account is now.
    match /dateNotes/{uid} {
      allow read, delete: if isSelf(uid);
      allow create, update: if isSelf(uid) && keepsNotes()
        && request.resource.data.size() <= 1000;
    }

    match /chordSheets/{id} {
      allow read: if isWorshipOrAdmin() || isGuest();
      allow write: if isWorshipOrAdmin();
    }

    match /inventoryCategories/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /inventoryItems/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /reorderItems/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /inputList/{location} {
      allow read: if isWorshipOrAdmin();
      allow write: if isWorshipOrAdmin();
    }

    match /photoAlbums/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // User reports about objectionable messages (App Store Guideline 1.2).
    // Reports are created server-side by the `reportContent` callable so a
    // reporter cannot forge or edit one; only admins can read and resolve them.
    match /contentReports/{id} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'resolvedBy', 'resolvedAt']);
      allow delete: if isAdmin();
    }

    // Facebook Page posts, mirrored in by the sync functions.
    //
    // Members read them; nobody writes from a client. The whole collection is
    // a cache of someone else's content, so a client write could only ever put
    // it out of step with Facebook.
    match /fbPagePosts/{pageId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /posts/{postId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // Page access tokens. Deliberately unreachable from any client, including
    // admins — the Admin SDK bypasses these rules, and nothing on a device
    // ever needs the token. Admin screens read connection health through the
    // `listFbConnections` callable, which returns everything except the token.
    match /fbConnections/{pageId} {
      allow read, write: if false;
    }

    // Miriam's own: what she has learned from Claude's answers, the answers
    // admins have taught her, what she read of the church's website, and her
    // web search key. Read and written only
    // by the server (functions/src/miriam/own); admins see and change them
    // through the miriamOwnAdmin callable, which never returns the key.
    match /miriamOwn/{docId} {
      allow read, write: if false;
    }

    // One-time connect invitations, consumed by the fbConnect web flow.
    match /fbConnectInvites/{inviteId} {
      allow read, write: if false;
      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /securityReports/{id} {
      function isSecurityOrAdmin() {
        return isSignedIn() &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles
            .hasAny(['admin', 'security']);
      }
      allow create: if isSignedIn();
      allow read: if isSecurityOrAdmin();
      allow update: if isSecurityOrAdmin();
      allow delete: if isAdmin();
    }
  }
}
