# Non-secret string params for the mission-team-portal project.
#
# Firebase Functions v2 resolves params from .env / .env.<projectId>; without a
# value here the CLI prompts interactively on every deploy, which blocks
# non-interactive deploys and risks someone accepting a placeholder by accident.
#
# Email is not in use yet — these mirror the defaults in src/email/client.ts and
# are intentionally placeholders. Push notifications do not use them. Replace
# both with the real addresses once a sending domain is verified in Resend.
#
# Secrets are NOT stored here — set them with:
#   firebase functions:secrets:set RESEND_API_KEY
MAIL_FROM="Mission Portal <noreply@yourdomain.com>"
MAIL_ADMIN_TO="admin@yourdomain.com"

# Public base URL the Facebook connect function is reachable at. Meta matches
# redirect_uri character for character against its registered list, so this must
# equal the "Valid OAuth Redirect URI" registered in the Meta app, less the
# /fbConnect that redirectUri() appends.
#
# It lives here because without a value the CLI prompts for it, and a deploy
# from CI has nobody to prompt: every automated Firebase deploy since the
# Facebook work landed has failed on exactly this.
FB_CONNECT_BASE_URL="https://us-central1-mission-team-portal.cloudfunctions.net"
