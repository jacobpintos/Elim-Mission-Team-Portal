# mission-portal-app/functions — configuration reference
#
# String params (Firebase Functions v2). Copy to `.env` (or `.env.<projectId>`)
# and fill in once your email domain is verified in Resend. If left unset, the
# defaults in src/email/client.ts are used.
MAIL_FROM="The Well of Iowa <noreply@your-verified-domain.com>"
MAIL_ADMIN_TO="contact@your-verified-domain.com"
#
# Secrets are NOT stored here — set them with the Firebase CLI:
#   firebase functions:secrets:set RESEND_API_KEY
#   firebase functions:secrets:set UNSUBSCRIBE_HMAC_SECRET
#   firebase functions:secrets:set RESEND_WEBHOOK_SECRET
